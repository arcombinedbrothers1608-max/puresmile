# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection string
DATABASE_URL="postgres://user:password@localhost:5432/puredent"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-key-change-this"

# WhatsApp Hybrid Dispatcher Configuration
# (If WHATSAPP_ACCESS_TOKEN & WHATSAPP_PHONE_ID are provided, OFFICIAL_API is used;
# otherwise gracefully falls back to PUPPETEER_FALLBACK automation engine with safe throttling)
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-access-token"
WHATSAPP_PHONE_ID="your-meta-phone-number-id"
WHATSAPP_API_VERSION="v19.0"
WHATSAPP_DELAY_MIN_SEC=15
WHATSAPP_DELAY_MAX_SEC=30

# Deployment & Networking Configuration
# VITE_API_URL: Set in frontend hosting (Vercel, Netlify) to point to your backend API.
# Leave empty or set to your custom backend domain (e.g., https://api.yourdomain.com or https://your-backend.up.railway.app)
VITE_API_URL=""

# FRONTEND_URL: Set in backend hosting to allow cross-origin requests from your frontend domain.
# E.g., https://yourdomain.com or https://your-frontend.vercel.app
FRONTEND_URL=""

# ALLOWED_ORIGINS: Comma-separated list of additional allowed CORS origins (custom domains, staging URLs)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
